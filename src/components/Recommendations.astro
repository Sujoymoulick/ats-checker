<div class="recommendations-card" id="recommendationsSection">
  <div class="card-header">
    <h3 class="card-title">Top Actionable Recommendations</h3>
    <p class="card-subtitle">Prioritized improvements to maximize your resume's ATS score</p>
  </div>

  <div class="rec-list" id="recommendationsListContainer">
    <!-- Populated by JS -->
  </div>
</div>

<style>
  .recommendations-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .card-header {
    margin-bottom: 1.25rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .card-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .rec-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
