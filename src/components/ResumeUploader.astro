---
---

<div class="uploader-container" id="uploader">
  <div 
    class="dropzone" 
    id="resumeDropzone" 
    tabindex="0" 
    role="button" 
    aria-label="Upload resume file in PDF, DOCX, or TXT format"
  >
    <input 
      type="file" 
      id="resumeFileInput" 
      accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" 
      class="file-input-hidden" 
    />

    <div class="dropzone-content" id="dropzoneContentIdle">
      <div class="upload-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <h3 class="upload-title">Drop your resume here or <span class="browse-link">browse</span></h3>
      <p class="upload-subtitle">Supports PDF, DOCX, and TXT (Max 10MB)</p>
      
      <div class="format-pills">
        <span class="pill">PDF</span>
        <span class="pill">DOCX</span>
        <span class="pill">TXT</span>
      </div>
    </div>

    <div class="dropzone-content hidden" id="dropzoneContentSelected">
      <div class="file-icon-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
        </svg>
      </div>
      <div class="selected-file-details">
        <div class="file-name" id="selectedFileName"></div>
        <div class="file-size" id="selectedFileSize"></div>
      </div>
      <button type="button" class="change-file-btn" id="changeFileBtn">Change file</button>
    </div>
  </div>

  <div class="error-message hidden" id="uploaderError" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="12" y1="8" x2="12" y2="12"></line>
      <line x1="12" y1="16" x2="12.01" y2="16"></line>
    </svg>
    <span id="uploaderErrorText">This file type isn't supported. Please upload a PDF, DOCX, or TXT resume.</span>
  </div>
</div>

<style>
  .uploader-container {
    width: 100%;
    margin-bottom: 1.5rem;
  }

  .dropzone {
    border: 2px dashed var(--color-border-light);
    border-radius: var(--radius-xl);
    background: var(--color-surface-card);
    padding: 2.5rem 1.5rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    outline: none;
    position: relative;
  }

  .dropzone:hover, .dropzone:focus-visible {
    border-color: var(--color-primary);
    background: #f8fafc;
    box-shadow: var(--shadow-glow);
  }

  .dropzone.dragover {
    border-color: var(--color-primary);
    background: rgba(2, 132, 199, 0.05);
    transform: scale(1.01);
  }

  .file-input-hidden {
    display: none;
  }

  .upload-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--color-primary-glow);
    color: var(--color-primary);
    margin-bottom: 1rem;
    border: 1px solid rgba(2, 132, 199, 0.2);
  }

  .upload-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.375rem;
  }

  .browse-link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .upload-subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-bottom: 1.25rem;
  }

  .format-pills {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    background: #f1f5f9;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* Selected File State */
  .dropzone-content.hidden,
  #dropzoneContentSelected.hidden,
  #dropzoneContentIdle.hidden {
    display: none !important;
  }

  #dropzoneContentSelected:not(.hidden) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .file-icon-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: rgba(5, 150, 105, 0.1);
    color: var(--color-success);
    border: 1px solid rgba(5, 150, 105, 0.25);
  }

  .file-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    word-break: break-all;
  }

  .file-size {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .change-file-btn {
    background: transparent;
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-md);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .change-file-btn:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .error-message {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-error-bg);
    border: 1px solid rgba(220, 38, 38, 0.2);
    border-radius: var(--radius-md);
    color: #dc2626;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .error-message.hidden {
    display: none;
  }
</style>
