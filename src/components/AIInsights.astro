---
---

<div class="ai-insights-card" id="aiInsightsCard">
  <div class="card-header">
    <div class="header-left">
      <span class="ai-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 3px;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        Cloudflare Workers AI
      </span>
      <h3 class="card-title">AI Resume Insights</h3>
      <p class="card-subtitle">Optional semantic analysis powered by Cloudflare Workers AI</p>
    </div>
    <div class="quota-badge" id="aiQuotaBadge">
      <span class="quota-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
      </span>
      <span id="aiQuotaCountText">2 free AI scans/day</span>
    </div>
  </div>

  <div class="privacy-notice-box">
    <div class="notice-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    </div>
    <div class="notice-text">
      <strong>Private by design:</strong> Your resume was parsed locally in your browser. AI insights are optional. When enabled, only the text required for analysis is sent securely to our Cloudflare Worker for AI processing. Zero files are stored.
    </div>
  </div>

  <!-- AI Trigger Container -->
  <div class="ai-action-container" id="aiActionContainer">
    <button type="button" class="btn-ai-trigger" id="getAiInsightsBtn">
      <span class="btn-sparkle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3z"/></svg>
      </span>
      <span>Get AI Resume Insights</span>
    </button>
    <span class="ai-subtext" id="aiActionSubtext">Client-side ATS report remains 100% available without AI</span>
  </div>

  <!-- Loading State -->
  <div class="ai-loading-box hidden" id="aiLoadingBox">
    <div class="spinner"></div>
    <div class="loading-text-wrap">
      <span class="loading-title">Analyzing resume with Cloudflare Workers AI...</span>
      <span class="loading-desc">Comparing semantic alignment, experience bullet quality, and requirement gaps...</span>
    </div>
  </div>

  <!-- Rate Limit Reached Banner -->
  <div class="ai-rate-limit-box hidden" id="aiRateLimitBox">
    <div class="rate-limit-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
    </div>
    <div class="rate-limit-content">
      <h4>Daily Scan Limit Reached (2/2)</h4>
      <p id="rateLimitMsgText">You've used both free AI resume scans for today. Your local ATS report is fully available above. Come back tomorrow for more AI scans.</p>
    </div>
  </div>

  <!-- Error / Unavailable Banner -->
  <div class="ai-error-box hidden" id="aiErrorBox">
    <div class="error-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    </div>
    <div class="error-content">
      <h4 id="aiErrorTitle">AI Insights Unavailable</h4>
      <p id="aiErrorMsgText">AI insights are temporarily unavailable. Your local ATS report remains 100% functional above.</p>
    </div>
  </div>

  <!-- AI Results Container -->
  <div class="ai-results-wrapper hidden" id="aiResultsWrapper">
    <!-- Top Match Score -->
    <div class="ai-score-banner">
      <div class="ai-score-ring">
        <span class="ai-score-num" id="aiSemanticMatchNum">--</span>
        <span class="ai-score-pct">%</span>
      </div>
      <div class="ai-score-info">
        <h4>Semantic Job Alignment</h4>
        <p>Measures conceptual skill overlap beyond exact keyword matching using AI LLM reasoning.</p>
      </div>
    </div>

    <!-- Strengths & Gaps Grid -->
    <div class="ai-insights-grid">
      <div class="insight-box box-strengths">
        <h4>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 4px; color: #059669;"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Key AI Strengths
        </h4>
        <ul id="aiStrengthsList"></ul>
      </div>

      <div class="insight-box box-gaps">
        <h4>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 4px; color: #d97706;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          Requirement Gaps
        </h4>
        <ul id="aiGapsList"></ul>
      </div>
    </div>

    <!-- Summary Feedback -->
    <div class="ai-section-box" id="aiSummarySection">
      <h4>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 6px; color: var(--color-primary);"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        Professional Summary Assessment
      </h4>
      <p class="summary-text" id="aiSummaryText"></p>
    </div>

    <!-- Bullet Feedback -->
    <div class="ai-section-box" id="aiBulletSection">
      <h4>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 6px; color: var(--color-primary);"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
        Experience Bullet Improvements
      </h4>
      <div class="bullets-feedback-list" id="aiBulletsList"></div>
    </div>

    <!-- Recommendations -->
    <div class="ai-section-box" id="aiRecsSection">
      <h4>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 6px; color: var(--color-primary);"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path></svg>
        Priority AI Recommendations
      </h4>
      <ul class="ai-recs-list" id="aiRecsList"></ul>
    </div>
  </div>
</div>

<style>
  .ai-insights-card {
    background: #ffffff;
    border: 1px solid rgba(79, 70, 229, 0.25);
    border-radius: var(--radius-xl);
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(79, 70, 229, 0.06);
    position: relative;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .ai-badge {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    background: rgba(79, 70, 229, 0.1);
    color: #4f46e5;
    border: 1px solid rgba(79, 70, 229, 0.2);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .card-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .quota-badge {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .privacy-notice-box {
    display: flex;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    background: rgba(2, 132, 199, 0.04);
    border: 1px solid rgba(2, 132, 199, 0.15);
    border-radius: var(--radius-lg);
    margin-bottom: 1.5rem;
    font-size: 0.84375rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .notice-icon {
    font-size: 1.125rem;
    flex-shrink: 0;
  }

  .ai-action-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 1rem 0;
  }

  .btn-ai-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    padding: 0.875rem 2rem;
    background: linear-gradient(135deg, #4f46e5 0%, #0284c7 100%);
    color: #ffffff;
    font-size: 1.0625rem;
    font-weight: 700;
    border: none;
    border-radius: var(--radius-lg);
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(79, 70, 229, 0.3);
    transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
  }

  .btn-ai-trigger:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
  }

  .btn-ai-trigger:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
  }

  .ai-subtext {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
  }

  /* Loading state */
  .ai-loading-box {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .spinner {
    width: 28px;
    height: 28px;
    border: 3px solid rgba(79, 70, 229, 0.2);
    border-top-color: #4f46e5;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    flex-shrink: 0;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .loading-title {
    display: block;
    font-weight: 700;
    color: var(--color-text);
    font-size: 0.9375rem;
  }

  .loading-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* Rate Limit Box */
  .ai-rate-limit-box {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(217, 119, 6, 0.08);
    border: 1px solid rgba(217, 119, 6, 0.25);
    border-radius: var(--radius-lg);
    color: #b45309;
  }

  .rate-limit-icon { font-size: 1.5rem; }
  .ai-rate-limit-box h4 { font-size: 1rem; font-weight: 700; margin-bottom: 0.25rem; }
  .ai-rate-limit-box p { font-size: 0.875rem; line-height: 1.5; }

  /* Error Box */
  .ai-error-box {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: rgba(37, 99, 235, 0.06);
    border: 1px solid rgba(37, 99, 235, 0.2);
    border-radius: var(--radius-lg);
    color: #1d4ed8;
  }

  .error-icon { font-size: 1.5rem; }

  /* Results styling */
  .ai-results-wrapper {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .ai-score-banner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, rgba(2, 132, 199, 0.05) 100%);
    border: 1px solid rgba(79, 70, 229, 0.2);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-lg);
  }

  .ai-score-ring {
    display: flex;
    align-items: baseline;
    justify-content: center;
    background: #4f46e5;
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    font-weight: 800;
  }

  .ai-score-num { font-size: 2rem; line-height: 1; }
  .ai-score-pct { font-size: 1.125rem; margin-left: 2px; }

  .ai-score-info h4 { font-size: 1.125rem; font-weight: 700; color: var(--color-text); margin-bottom: 0.25rem; }
  .ai-score-info p { font-size: 0.875rem; color: var(--color-text-muted); }

  .ai-insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .insight-box {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .insight-box h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .box-strengths h4 { color: #047857; }
  .box-gaps h4 { color: #b45309; }

  .insight-box ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .insight-box li {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    position: relative;
    padding-left: 1.25rem;
  }

  .box-strengths li::before {
    content: '•';
    color: #059669;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .box-gaps li::before {
    content: '•';
    color: #d97706;
    font-weight: bold;
    position: absolute;
    left: 0;
  }

  .ai-section-box {
    background: #f8fafc;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
  }

  .ai-section-box h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .summary-text {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .bullets-feedback-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bullet-item {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
  }

  .bullet-orig {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.375rem;
    font-style: italic;
  }

  .bullet-issue {
    font-size: 0.8125rem;
    color: #dc2626;
    font-weight: 600;
    margin-bottom: 0.375rem;
  }

  .bullet-sug {
    font-size: 0.875rem;
    color: #047857;
    font-weight: 500;
  }

  .ai-recs-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .ai-recs-list li {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding-left: 1.25rem;
    position: relative;
    line-height: 1.5;
  }

  .ai-recs-list li::before {
    content: '→';
    color: #4f46e5;
    font-weight: bold;
    position: absolute;
    left: 0;
  }
</style>
