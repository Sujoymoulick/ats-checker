  function setupCompileEvents() {
    compileBtn.addEventListener('click', compileLaTeX);
    
    prevPageBtn?.addEventListener('click', () => {
      if (currentPageNumber > 1) {
        renderPage(currentPageNumber - 1);
      }
    });

    nextPageBtn?.addEventListener('click', () => {
      if (currentPageNumber < totalPageCount) {
        renderPage(currentPageNumber + 1);
      }
    });
  }

  async function compileLaTeX() {
    setCompileStatus('compiling', 'Compiling LaTeX...');
    previewLoading.classList.remove('hidden');

    const result = await defaultCompiler.compile(currentSource);

    if (import.meta.env.DEV) {
      console.log("LaTeX compile result:", result);
      console.log("PDF exists:", !!result.pdf);
      console.log("PDF type:", result.pdf?.constructor?.name);
      console.log("PDF byte length:", result.pdf?.byteLength);
    }

    if (result.success && result.pdf) {
      try {
        validatePdfBytes(result.pdf);
        const pdfBlob = pdfBytesToBlob(result.pdf);
        currentCompiledPdfBlob = pdfBlob;

        if (import.meta.env.DEV) {
          console.log("PDF Blob:", pdfBlob);
          console.log("PDF Blob size:", pdfBlob.size);
          console.log("PDF Blob type:", pdfBlob.type);
        }

        if (currentCompiledPdfUrl) {
          URL.revokeObjectURL(currentCompiledPdfUrl);
        }
        currentCompiledPdfUrl = URL.createObjectURL(pdfBlob);

        if (result.errors && result.errors.length > 0) {
          setCompileStatus('warning', `Compiled (${result.errors.length} warnings)`);
          showErrors(result.errors);
        } else {
          setCompileStatus('success', 'Compiled successfully');
          errorPanel.classList.add('hidden');
        }

        lastCompileTime.textContent = `Compiled ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })}`;
        
        await loadAndRenderPdf(currentCompiledPdfUrl);
      } catch (valErr: any) {
        console.error('PDF validation failed:', valErr);
        setCompileStatus('error', 'Invalid PDF binary');
        previewLoading.classList.add('hidden');
        showPdfError(valErr);
      }
    } else {
      setCompileStatus('error', 'Compilation failed');
      previewLoading.classList.add('hidden');
      showErrors(result.errors || []);
    }
  }

  async function loadAndRenderPdf(pdfUrl: string) {
    if (!pdfUrl) return;

    const rect = pdfScrollContainer.getBoundingClientRect();
    if (rect.width <= 0) {
      previewLoading.classList.add('hidden');
      return;
    }

    previewLoading.classList.remove('hidden');
    if (previewError) previewError.classList.add('hidden');
    if (previewPlaceholder) previewPlaceholder.classList.add('hidden');

    try {
      if (currentPdfDoc) {
        try { await currentPdfDoc.destroy(); } catch (e) {}
        currentPdfDoc = null;
      }

      currentPageNumber = 1;

      const loadingTask = pdfjsLib.getDocument({ url: pdfUrl });
      currentPdfDoc = await loadingTask.promise;

      totalPageCount = currentPdfDoc.numPages;

      await renderPage(currentPageNumber);

      previewLoading.classList.add('hidden');
      if (pdfIframe) pdfIframe.classList.add('hidden');
    } catch (err: any) {
      console.error('PDF.js loading error:', err);
      previewLoading.classList.add('hidden');
      showPdfError(err);

      // Fallback to iframe if pdfjs fails but Blob URL exists
      if (currentCompiledPdfUrl && pdfIframe) {
        pdfIframe.src = currentCompiledPdfUrl;
        pdfIframe.classList.remove('hidden');
        pdfCanvasWrapper.classList.add('hidden');
        previewPlaceholder.classList.add('hidden');
      }
    }
  }

  async function renderPage(pageNo: number) {
    if (!currentPdfDoc) return;

    const renderId = ++currentRenderId;

    currentPageNumber = Math.max(1, Math.min(pageNo, totalPageCount));
    pageCountDisplay.textContent = `Page ${currentPageNumber} / ${totalPageCount}`;
    updatePageNavButtons();

    const page = await currentPdfDoc.getPage(currentPageNumber);
    if (renderId !== currentRenderId) return;

    const outputScale = window.devicePixelRatio || 1;
    const viewport = page.getViewport({ scale: currentZoom });

    // Set high-DPI canvas dimensions
    pdfCanvas.width = Math.floor(viewport.width * outputScale);
    pdfCanvas.height = Math.floor(viewport.height * outputScale);
    pdfCanvas.style.width = `${viewport.width}px`;
    pdfCanvas.style.height = `${viewport.height}px`;

    // Synchronize page container & layer dimensions
    pdfCanvasWrapper.style.width = `${viewport.width}px`;
    pdfCanvasWrapper.style.height = `${viewport.height}px`;
    pdfTextLayer.style.width = `${viewport.width}px`;
    pdfTextLayer.style.height = `${viewport.height}px`;
    pdfAnnotLayer.style.width = `${viewport.width}px`;
    pdfAnnotLayer.style.height = `${viewport.height}px`;

    // Clear previous layers before new render
    pdfTextLayer.replaceChildren();
    pdfAnnotLayer.replaceChildren();

    const canvasContext = pdfCanvas.getContext('2d');
    if (!canvasContext) throw new Error('Could not get 2D canvas context');

    canvasContext.fillStyle = '#ffffff';
    canvasContext.fillRect(0, 0, pdfCanvas.width, pdfCanvas.height);

    const renderContext = {
      canvasContext,
      viewport,
      transform: outputScale !== 1 ? [outputScale, 0, 0, outputScale, 0, 0] : undefined
    };

    if (activeRenderTask) {
      try { activeRenderTask.cancel(); } catch (e) {}
    }
    activeRenderTask = page.render(renderContext);
    await activeRenderTask.promise;

    if (renderId !== currentRenderId) return;

    // Render Text Selection Layer using official PDF.js TextLayer API
    try {
      if (activeTextTask) {
        try { activeTextTask.cancel(); } catch (e) {}
      }
      const textContent = await page.getTextContent();
      if (renderId !== currentRenderId) return;

      const textLayer = new pdfjsLib.TextLayer({
        textContentSource: textContent,
        container: pdfTextLayer,
        viewport: viewport
      });
      activeTextTask = textLayer;
      await textLayer.render();
    } catch (textErr: any) {
      if (textErr?.name !== 'RenderingCancelledException') {
        console.warn('PDF.js TextLayer rendering warning:', textErr);
      }
    }

    if (renderId !== currentRenderId) return;

    // Render Clickable Hyperlink Annotations using PDF.js AnnotationLayer API
    try {
      const annotations = await page.getAnnotations();
      if (renderId !== currentRenderId) return;

      if (annotations && annotations.length > 0) {
        const linkService = {
          getDestinationHash: () => '#',
          getAnchorUrl: (hash: string) => hash,
          setHash: () => {},
          executeNamedAction: () => {},
          addLinkAttributes: (link: HTMLAnchorElement, url: string, newWindow: boolean) => {
            link.href = url;
            if (newWindow || url.startsWith('http') || url.startsWith('mailto:')) {
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
            }
          }
        };

        const annotationLayer = new (pdfjsLib.AnnotationLayer as any)({
          div: pdfAnnotLayer,
          page: page,
          viewport: viewport,
          linkService: linkService as any,
          accessibilityManager: null,
          annotationCanvasMap: null,
          annotationEditorUIManager: null,
          structTreeLayer: null,
          commentManager: null,
          annotationStorage: null
        });

        await annotationLayer.render({
          viewport: viewport,
          div: pdfAnnotLayer,
          annotations: annotations,
          page: page,
          linkService: linkService as any,
          renderForms: false
        });
      }
    } catch (annotErr: any) {
      console.warn('PDF.js AnnotationLayer warning, using fallback link overlays:', annotErr);
      pdfAnnotLayer.replaceChildren();
      const annotations = await page.getAnnotations();
      for (const annot of annotations) {
        if (annot.subtype === 'Link' && annot.url) {
          const a = document.createElement('a');
          a.href = annot.url;
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          a.className = 'pdf-link-annot';
          
          const rect = annot.rect;
          const left = rect[0] * currentZoom;
          const top = viewport.height - (rect[3] * currentZoom);
          const width = (rect[2] - rect[0]) * currentZoom;
          const height = (rect[3] - rect[1]) * currentZoom;

          a.style.position = 'absolute';
          a.style.left = `${left}px`;
          a.style.top = `${top}px`;
          a.style.width = `${width}px`;
          a.style.height = `${height}px`;
          a.title = annot.url;

          pdfAnnotLayer.appendChild(a);
        }
      }
    }

    if (renderId === currentRenderId) {
      pdfCanvasWrapper.classList.remove('hidden');
    }
  }

  function updatePageNavButtons() {
    if (prevPageBtn) prevPageBtn.disabled = currentPageNumber <= 1;
    if (nextPageBtn) nextPageBtn.disabled = currentPageNumber >= totalPageCount;
  }

  function showPdfError(err: any) {
