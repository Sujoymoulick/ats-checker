---
import Header from '../Header.astro';
---

<div class="latex-builder-root" id="latexBuilderRoot">
  <!-- Top App Toolbar -->
  <header class="builder-toolbar">
    <div class="toolbar-brand">
      <span class="brand-title">LaTeX Resume Builder</span>
      <span class="version-badge">LaTeX engine</span>
    </div>

    <!-- Actions / Control Bar -->
    <div class="toolbar-controls">
      <!-- Template Selector -->
      <div class="control-group">
        <label for="templateSelect" class="control-label">Template:</label>
        <select id="templateSelect" class="btn-select">
          <option value="ats-professional">ATS Professional (Default)</option>
          <option value="software-engineer">Software Engineer</option>
          <option value="data-scientist">Data Scientist</option>
          <option value="product-manager">Product Manager</option>
          <option value="marketing-manager">Marketing Manager</option>
          <option value="financial-analyst">Financial Analyst</option>
          <option value="graduate-fresher">Graduate / Entry Level</option>
          <option value="engineering-manager">Engineering Manager</option>
          <option value="sales-manager">Sales Manager</option>
          <option value="ux-designer">UX / UI Designer</option>
        </select>
      </div>

      <!-- Action Buttons -->
      <button id="compileBtn" class="btn btn-primary" title="Compile LaTeX source (Ctrl+Enter)">
        <span class="btn-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        </span>
        <span class="btn-text">Compile</span>
      </button>

      <button id="downloadPdfBtn" class="btn btn-secondary" title="Download compiled PDF">
        <span class="btn-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
        </span>
        <span>Download PDF</span>
      </button>

      <button id="scanResumeBtn" class="btn btn-accent" title="Scan compiled PDF using ATS Scanner">
        <span class="btn-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </span>
        <span>Scan Resume</span>
      </button>

      <div class="dropdown-wrap">
        <button id="moreActionsBtn" class="btn btn-ghost" title="More Options">
          <span>More</span>
          <span class="chevron">▼</span>
        </button>
        <div id="moreActionsMenu" class="dropdown-menu hidden">
          <button id="downloadTexBtn" class="dropdown-item">Download .tex</button>
          <button id="importTexBtn" class="dropdown-item">Import .tex File</button>
          <button id="saveLocalBtn" class="dropdown-item">Save to LocalStorage</button>
          <button id="resetSourceBtn" class="dropdown-item danger">Reset to Template</button>
          <input type="file" id="importTexInput" accept=".tex,.txt" class="hidden" />
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Tab Switcher -->
  <div class="mobile-tabs">
    <button id="tabCodeBtn" class="tab-btn active">Code Editor</button>
    <button id="tabPreviewBtn" class="tab-btn">PDF Preview</button>
  </div>

  <!-- Main Split Workspace -->
  <div class="builder-workspace" id="builderWorkspace">
    <!-- LEFT PANEL: LATEX CODE EDITOR -->
    <div class="workspace-panel panel-editor" id="editorPanel">
      <!-- Editor Header Toolbar -->
      <div class="editor-header">
        <div class="editor-title-wrap">
          <span class="editor-title">LaTeX Source (main.tex)</span>
          <span id="saveStatusIndicator" class="save-status">Saved locally</span>
        </div>

        <div class="editor-tools">
          <button id="toggleWrapBtn" class="tool-btn" title="Toggle Word Wrap">Wrap: On</button>
          <button id="toggleThemeBtn" class="tool-btn" title="Toggle Dark/Light Editor Theme">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            <span>Light</span>
          </button>
          
          <div class="font-size-controls">
            <button id="fontDecBtn" class="tool-btn font-btn" title="Decrease Font Size">-</button>
            <span id="fontSizeDisplay" class="font-size-val">13px</span>
            <button id="fontIncBtn" class="tool-btn font-btn" title="Increase Font Size">+</button>
          </div>

          <button id="openSearchBtn" class="tool-btn" title="Search & Replace (Ctrl+F)">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <span>Find</span>
          </button>
        </div>
      </div>

      <!-- Search & Replace Dialog Bar -->
      <div id="searchBar" class="search-bar hidden">
        <div class="search-inputs">
          <input type="text" id="searchInput" placeholder="Find text..." class="search-field" />
          <input type="text" id="replaceInput" placeholder="Replace with..." class="search-field" />
        </div>
        <div class="search-actions">
          <button id="findNextBtn" class="btn-sm">Find Next</button>
          <button id="replaceBtn" class="btn-sm">Replace</button>
          <button id="replaceAllBtn" class="btn-sm">Replace All</button>
          <button id="closeSearchBtn" class="btn-sm btn-close">✕</button>
        </div>
      </div>

      <!-- Code Area Container -->
      <div class="editor-container light-theme" id="editorContainer">
        <div class="line-numbers" id="lineNumbers">1</div>
        <div class="editor-wrapper">
          <textarea 
            id="latexTextarea" 
            class="latex-textarea" 
            spellcheck="false" 
            placeholder="Type your LaTeX source code here..."
          ></textarea>
        </div>
      </div>

      <!-- ATS Safety Indicator Banner -->
      <div class="ats-safety-bar" id="atsSafetyBar">
        <div class="ats-safety-header">
          <div class="ats-status-badge safe" id="atsSafetyBadge">
            <span class="status-icon">✓</span>
            <span class="status-text">ATS Safe Structure</span>
          </div>
          <span class="ats-summary-text" id="atsSummaryText">Single column • Selectable text • Clickable links</span>
          <button id="toggleAtsDetailsBtn" class="btn-link">Details ▼</button>
        </div>

        <div id="atsDetailsPanel" class="ats-details-panel hidden">
          <div class="ats-checks-grid" id="atsChecksGrid">
            <!-- Rendered by JS -->
          </div>
          <div id="atsWarningsBox" class="ats-warnings-box hidden">
            <!-- Warnings -->
          </div>
        </div>
      </div>
    </div>

    <!-- RESIZABLE SPLIT DIVIDER -->
    <div class="workspace-divider" id="workspaceDivider" title="Drag to resize panels"></div>

    <!-- RIGHT PANEL: LIVE PDF PREVIEW -->
    <div class="workspace-panel panel-preview" id="previewPanel">
      <!-- Preview Header Controls -->
      <div class="preview-header">
        <div class="preview-title-wrap">
          <span class="preview-title">PDF Preview</span>
          <button id="prevPageBtn" class="control-btn" title="Previous Page" disabled>◀</button>
          <span id="pageCountDisplay" class="page-count-val">Page 1 / 1</span>
          <button id="nextPageBtn" class="control-btn" title="Next Page" disabled>▶</button>
        </div>

        <div class="preview-controls">
          <button id="zoomOutBtn" class="control-btn" title="Zoom Out">-</button>
          <span id="zoomValDisplay" class="zoom-val">100%</span>
          <button id="zoomInBtn" class="control-btn" title="Zoom In">+</button>

          <button id="zoomFitWidthBtn" class="control-btn" title="Fit to Width">Fit Width</button>
          <button id="zoomFitPageBtn" class="control-btn" title="Fit Page">Fit Page</button>

          <button id="openNativePdfBtn" class="control-btn" title="Open PDF in native browser viewer">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            <span>Open PDF</span>
          </button>
          <button id="fullscreenBtn" class="control-btn" title="Fullscreen Preview">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            <span>Fullscreen</span>
          </button>
        </div>
      </div>

      <!-- PDF Canvas Scroll Container -->
      <div class="pdf-scroll-container" id="pdfScrollContainer">
        <div class="pdf-page hidden" id="pdfCanvasWrapper">
          <canvas id="pdfCanvas" class="pdf-canvas"></canvas>
          <div id="pdfTextLayer" class="textLayer"></div>
          <div id="pdfAnnotLayer" class="annotationLayer"></div>
        </div>
        
        <iframe id="pdfIframe" class="pdf-iframe hidden" title="PDF Live Preview"></iframe>
        
        <!-- Loading Overlay -->
        <div id="previewLoading" class="preview-overlay hidden">
          <div class="spinner"></div>
          <span>Compiling & Rendering PDF...</span>
        </div>

        <!-- Empty Placeholder -->
        <div id="previewPlaceholder" class="preview-placeholder">
          <div class="placeholder-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          </div>
          <p class="placeholder-title">No PDF Generated Yet</p>
          <p class="placeholder-desc">Click <strong>Compile</strong> (Ctrl+Enter) to generate the live ATS PDF preview.</p>
        </div>

        <!-- Error State Placeholder -->
        <div id="previewError" class="preview-placeholder hidden">
          <div class="placeholder-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
          </div>
          <p class="placeholder-title">PDF Preview Failed</p>
          <p id="previewErrorMsg" class="placeholder-desc">Possible reasons: PDF data is invalid, PDF.js worker failed, or object URL was blocked.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Compile Status Bar -->
  <footer class="builder-statusbar">
    <div class="status-item">
      <span class="status-dot idle" id="compileStatusDot"></span>
      <span id="compileStatusText" class="status-text">Ready to compile</span>
    </div>

    <div class="status-item meta">
      <span id="lineColCounter">Line 1, Col 1</span>
      <span class="sep">•</span>
      <span id="lastCompileTime">Not compiled yet</span>
    </div>
  </footer>

  <!-- Compiler Error Jump Drawer -->
  <div id="errorPanel" class="error-panel hidden">
    <div class="error-header">
      <div class="error-title">
        <span class="error-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </span>
        <span>Syntax Notices & Warnings</span>
      </div>
      <button id="closeErrorBtn" class="btn-sm btn-close">✕</button>
    </div>
    <div id="errorListContainer" class="error-list">
      <!-- Populated by JS -->
    </div>
  </div>

  <!-- ATS Scan Score Modal -->
  <div id="atsScanModal" class="modal-backdrop hidden">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title">
          <span>ATS Score Report</span>
          <span class="modal-subtitle">Direct evaluation of compiled resume PDF</span>
        </div>
        <button id="closeScanModalBtn" class="modal-close">✕</button>
      </div>

      <div class="modal-body" id="scanModalBody">
        <div id="scanLoadingState" class="scan-loading">
          <div class="spinner"></div>
          <p>Extracting PDF text and analyzing ATS compatibility...</p>
        </div>

        <div id="scanResultsState" class="scan-results hidden">
          <!-- Main Score Gauge -->
          <div class="scan-score-header">
            <div class="score-circle-wrap">
              <span id="modalScoreVal" class="score-number">92</span>
              <span class="score-denom">/ 100</span>
            </div>
            <div class="score-info">
              <h3 id="modalScoreCategory" class="score-cat">Excellent Fit</h3>
              <p id="modalScoreExp" class="score-desc">This resume passes key ATS formatting, structure, and keyword checks.</p>
            </div>
          </div>

          <!-- Score Breakdown Grid -->
          <div class="scan-breakdown-grid" id="modalBreakdownGrid">
            <!-- Breakdown items -->
          </div>

          <!-- Recommendations -->
          <div class="scan-recs-section">
            <h4>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 4px; color: var(--color-warning);"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path></svg>
              Recommended Improvements
            </h4>
            <div id="modalRecsList" class="modal-recs-list">
              <!-- Recommendations -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  import * as pdfjsLib from 'pdfjs-dist';
  import pdfjsWorker from 'pdfjs-dist/build/pdf.worker.min.mjs?url';
  import 'pdfjs-dist/web/pdf_viewer.css';
  import { defaultCompiler } from '../../lib/latex/compiler';
  import { ATS_TEMPLATES, getTemplateById } from '../../lib/latex/templates';
  import { auditATSCompatibility, validateLatexLinks } from '../../lib/latex/parser';
  import { parsePdfFile } from '../../lib/ats/pdfParser';
  import { analyzeResume } from '../../lib/ats/analyzer';
  import { pdfBytesToBlob, validatePdfBytes } from '../../lib/latex/pdfUtils';

  // Configure pdfjs worker
  if (typeof window !== 'undefined' && pdfjsLib.GlobalWorkerOptions) {
    pdfjsLib.GlobalWorkerOptions.workerSrc = pdfjsWorker;
  }

  // Application State
  let currentSource = ATS_TEMPLATES[0].latexSource;
  let currentCompiledPdfBlob: Blob | null = null;
  let currentPdfDoc: any = null;
  let currentZoom = 1.0;
  let isWordWrap = true;
  let isDarkTheme = false;
  let currentFontSize = 13;
  let currentPageNumber = 1;
  let totalPageCount = 1;

  // Render Task Synchronization & Cancellation
  let currentRenderId = 0;
  let activeRenderTask: any = null;
  let activeTextTask: any = null;

  // DOM Elements
  const latexTextarea = document.getElementById('latexTextarea') as HTMLTextAreaElement;
  const lineNumbers = document.getElementById('lineNumbers') as HTMLElement;
  const editorContainer = document.getElementById('editorContainer') as HTMLElement;
  const templateSelect = document.getElementById('templateSelect') as HTMLSelectElement;
  
  const compileBtn = document.getElementById('compileBtn') as HTMLButtonElement;
  const downloadPdfBtn = document.getElementById('downloadPdfBtn') as HTMLButtonElement;
  const scanResumeBtn = document.getElementById('scanResumeBtn') as HTMLButtonElement;
  const downloadTexBtn = document.getElementById('downloadTexBtn') as HTMLButtonElement;
  const importTexBtn = document.getElementById('importTexBtn') as HTMLButtonElement;
  const importTexInput = document.getElementById('importTexInput') as HTMLInputElement;
  const saveLocalBtn = document.getElementById('saveLocalBtn') as HTMLButtonElement;
  const resetSourceBtn = document.getElementById('resetSourceBtn') as HTMLButtonElement;
  const moreActionsBtn = document.getElementById('moreActionsBtn') as HTMLButtonElement;
  const moreActionsMenu = document.getElementById('moreActionsMenu') as HTMLElement;

  const toggleWrapBtn = document.getElementById('toggleWrapBtn') as HTMLButtonElement;
  const toggleThemeBtn = document.getElementById('toggleThemeBtn') as HTMLButtonElement;
  const fontDecBtn = document.getElementById('fontDecBtn') as HTMLButtonElement;
  const fontIncBtn = document.getElementById('fontIncBtn') as HTMLButtonElement;
  const fontSizeDisplay = document.getElementById('fontSizeDisplay') as HTMLElement;
  
  const openSearchBtn = document.getElementById('openSearchBtn') as HTMLButtonElement;
  const searchBar = document.getElementById('searchBar') as HTMLElement;
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const replaceInput = document.getElementById('replaceInput') as HTMLInputElement;
  const findNextBtn = document.getElementById('findNextBtn') as HTMLButtonElement;
  const replaceBtn = document.getElementById('replaceBtn') as HTMLButtonElement;
  const replaceAllBtn = document.getElementById('replaceAllBtn') as HTMLButtonElement;
  const closeSearchBtn = document.getElementById('closeSearchBtn') as HTMLButtonElement;

  let currentCompiledPdfUrl: string | null = null;

  const pdfCanvasWrapper = document.getElementById('pdfCanvasWrapper') as HTMLElement;
  const pdfCanvas = document.getElementById('pdfCanvas') as HTMLCanvasElement;
  const pdfTextLayer = document.getElementById('pdfTextLayer') as HTMLElement;
  const pdfAnnotLayer = document.getElementById('pdfAnnotLayer') as HTMLElement;
  const pdfIframe = document.getElementById('pdfIframe') as HTMLIFrameElement;
  const previewLoading = document.getElementById('previewLoading') as HTMLElement;
  const previewPlaceholder = document.getElementById('previewPlaceholder') as HTMLElement;
  const previewError = document.getElementById('previewError') as HTMLElement;
  const previewErrorMsg = document.getElementById('previewErrorMsg') as HTMLElement;
  const pdfScrollContainer = document.getElementById('pdfScrollContainer') as HTMLElement;

  const zoomInBtn = document.getElementById('zoomInBtn') as HTMLButtonElement;
  const zoomOutBtn = document.getElementById('zoomOutBtn') as HTMLButtonElement;
  const zoomValDisplay = document.getElementById('zoomValDisplay') as HTMLElement;
  const zoomFitWidthBtn = document.getElementById('zoomFitWidthBtn') as HTMLButtonElement;
  const zoomFitPageBtn = document.getElementById('zoomFitPageBtn') as HTMLButtonElement;
  const openNativePdfBtn = document.getElementById('openNativePdfBtn') as HTMLButtonElement;
  const fullscreenBtn = document.getElementById('fullscreenBtn') as HTMLButtonElement;
  const pageCountDisplay = document.getElementById('pageCountDisplay') as HTMLElement;
  const prevPageBtn = document.getElementById('prevPageBtn') as HTMLButtonElement;
  const nextPageBtn = document.getElementById('nextPageBtn') as HTMLButtonElement;

  const compileStatusDot = document.getElementById('compileStatusDot') as HTMLElement;
  const compileStatusText = document.getElementById('compileStatusText') as HTMLElement;
  const lineColCounter = document.getElementById('lineColCounter') as HTMLElement;
  const lastCompileTime = document.getElementById('lastCompileTime') as HTMLElement;
  const errorPanel = document.getElementById('errorPanel') as HTMLElement;
  const errorListContainer = document.getElementById('errorListContainer') as HTMLElement;
  const closeErrorBtn = document.getElementById('closeErrorBtn') as HTMLButtonElement;
  const saveStatusIndicator = document.getElementById('saveStatusIndicator') as HTMLElement;

  const atsSafetyBar = document.getElementById('atsSafetyBar') as HTMLElement;
  const atsSafetyBadge = document.getElementById('atsSafetyBadge') as HTMLElement;
  const atsSummaryText = document.getElementById('atsSummaryText') as HTMLElement;
  const toggleAtsDetailsBtn = document.getElementById('toggleAtsDetailsBtn') as HTMLButtonElement;
  const atsDetailsPanel = document.getElementById('atsDetailsPanel') as HTMLElement;
  const atsChecksGrid = document.getElementById('atsChecksGrid') as HTMLElement;
  const atsWarningsBox = document.getElementById('atsWarningsBox') as HTMLElement;

  const atsScanModal = document.getElementById('atsScanModal') as HTMLElement;
  const closeScanModalBtn = document.getElementById('closeScanModalBtn') as HTMLButtonElement;
  const scanLoadingState = document.getElementById('scanLoadingState') as HTMLElement;
  const scanResultsState = document.getElementById('scanResultsState') as HTMLElement;

  const tabCodeBtn = document.getElementById('tabCodeBtn') as HTMLButtonElement;
  const tabPreviewBtn = document.getElementById('tabPreviewBtn') as HTMLButtonElement;
  const editorPanel = document.getElementById('editorPanel') as HTMLElement;
  const previewPanel = document.getElementById('previewPanel') as HTMLElement;
  const workspaceDivider = document.getElementById('workspaceDivider') as HTMLElement;
  const builderWorkspace = document.getElementById('builderWorkspace') as HTMLElement;

  // Initialize App
  init();

  function init() {
    // Load local storage if present
    const savedSource = localStorage.getItem('gigpilot_latex_source');
    if (savedSource) {
      currentSource = savedSource;
    }
    latexTextarea.value = currentSource;
    updateLineNumbers();
    runAtsAudit();

    // Event Listeners
    setupEditorEvents();
    setupToolbarEvents();
    setupCompileEvents();
    setupZoomEvents();
    setupDividerDrag();
    setupMobileTabs();

    // Initial Compilation
    compileLaTeX();
  }

  function setupEditorEvents() {
    latexTextarea.addEventListener('input', () => {
      currentSource = latexTextarea.value;
      updateLineNumbers();
      saveToLocal(true);
      runAtsAudit();
    });

    latexTextarea.addEventListener('scroll', () => {
      lineNumbers.scrollTop = latexTextarea.scrollTop;
    });

    latexTextarea.addEventListener('keyup', updateCursorPosition);
    latexTextarea.addEventListener('click', updateCursorPosition);

    // Keyboard Shortcuts
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        saveToLocal(false);
      }
      if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
        e.preventDefault();
        compileLaTeX();
      }
      if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
        e.preventDefault();
        openSearch();
      }
      if (e.key === 'Escape') {
        closeSearch();
        closeScanModal();
        errorPanel.classList.add('hidden');
      }
    });

    // Tab key indentation
    latexTextarea.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        e.preventDefault();
        const start = latexTextarea.selectionStart;
        const end = latexTextarea.selectionEnd;
        latexTextarea.value = latexTextarea.value.substring(0, start) + '  ' + latexTextarea.value.substring(end);
        latexTextarea.selectionStart = latexTextarea.selectionEnd = start + 2;
        currentSource = latexTextarea.value;
        updateLineNumbers();
      }
    });
  }

  function updateLineNumbers() {
    const lines = latexTextarea.value.split('\n');
    lineNumbers.innerHTML = lines.map((_, i) => `<div>${i + 1}</div>`).join('');
  }

  function updateCursorPosition() {
    const selStart = latexTextarea.selectionStart;
    const textBefore = latexTextarea.value.substring(0, selStart);
    const lineNum = textBefore.split('\n').length;
    const colNum = selStart - textBefore.lastIndexOf('\n');
    lineColCounter.textContent = `Line ${lineNum}, Col ${colNum}`;
  }

  function setupToolbarEvents() {
    // Template Select
    templateSelect.addEventListener('change', () => {
      if (currentSource !== ATS_TEMPLATES[0].latexSource) {
        if (!confirm('Replace current resume source code with this template? Any unsaved changes will be replaced.')) {
          return;
        }
      }
