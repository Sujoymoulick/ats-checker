  function setCompileStatus(state: 'idle' | 'compiling' | 'success' | 'warning' | 'error', text: string) {
    compileStatusDot.className = `status-dot ${state}`;
    compileStatusText.textContent = text;
  }

  function showErrors(errors: any[]) {
    errorListContainer.innerHTML = '';
    for (const err of errors) {
      const item = document.createElement('div');
      item.className = 'error-item';
      item.innerHTML = `
        <div class="error-line-badge">Line ${err.line}</div>
        <div class="error-msg-wrap">
          <div class="error-msg">${err.message}</div>
          ${err.codeSnippet ? `<code class="error-code">${err.codeSnippet}</code>` : ''}
        </div>
        <button class="btn-jump">Go to line</button>
      `;

      const jumpBtn = item.querySelector('.btn-jump');
      jumpBtn?.addEventListener('click', () => {
        jumpToLine(err.line);
      });

      errorListContainer.appendChild(item);
    }
    errorPanel.classList.remove('hidden');
  }

  function jumpToLine(lineNum: number) {
    const lines = latexTextarea.value.split('\n');
    let pos = 0;
    for (let i = 0; i < Math.min(lineNum - 1, lines.length); i++) {
      pos += lines[i].length + 1;
    }
    latexTextarea.focus();
    latexTextarea.setSelectionRange(pos, pos + (lines[lineNum - 1]?.length || 0));

    // Scroll textarea to line
    const lineHeight = 19;
    latexTextarea.scrollTop = (lineNum - 3) * lineHeight;
  }

  function saveToLocal(isAuto: boolean) {
    localStorage.setItem('gigpilot_latex_source', currentSource);
    saveStatusIndicator.textContent = isAuto ? 'Autosaved locally' : 'Saved locally';
    saveStatusIndicator.style.opacity = '1';
    setTimeout(() => {
      saveStatusIndicator.style.opacity = '0.7';
    }, 2000);
  }

  function runAtsAudit() {
    const report = auditATSCompatibility(currentSource);
    const links = validateLatexLinks(currentSource);

    if (report.isATSSafe) {
      atsSafetyBadge.className = 'ats-status-badge safe';
      atsSafetyBadge.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span>ATS Safe Structure</span>';
    } else {
      atsSafetyBadge.className = 'ats-status-badge warning';
      atsSafetyBadge.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg><span>ATS Risk Flagged</span>';
    }

    atsSummaryText.textContent = `${report.checks.filter(c => c.passed).length} / ${report.checks.length} ATS checks passed • ${links.length} links validated`;

    atsChecksGrid.innerHTML = report.checks.map(c => `
      <div class="ats-check-card ${c.passed ? 'passed' : 'failed'}">
        <span class="check-icon">${c.passed ? '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>' : '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'}</span>
        <div class="check-info">
          <span class="check-title">${c.label}</span>
          <span class="check-desc">${c.details}</span>
        </div>
      </div>
    `).join('');

    const linkWarnings = links.filter(l => l.warning);
    if (linkWarnings.length > 0) {
      atsWarningsBox.classList.remove('hidden');
      atsWarningsBox.innerHTML = '<strong>Hyperlink Warnings:</strong>' + linkWarnings.map(w => `<div class="warn-line">Line ${w.line}: ${w.warning}</div>`).join('');
    } else {
      atsWarningsBox.classList.add('hidden');
    }
  }

  async function runAtsScanOnPdf() {
    if (!currentCompiledPdfBlob) {
      alert('Please compile your resume first before running the ATS scanner.');
      return;
    }

    atsScanModal.classList.remove('hidden');
    scanLoadingState.classList.remove('hidden');
    scanResultsState.classList.add('hidden');

    try {
      const file = new File([currentCompiledPdfBlob], 'resume.pdf', { type: 'application/pdf' });
      const parsed = await parsePdfFile(file);
      const result = analyzeResume(parsed);

      renderScanResults(result);

      scanLoadingState.classList.add('hidden');
      scanResultsState.classList.remove('hidden');
    } catch (err: any) {
      console.error('Scan error:', err);
      alert('Failed to scan PDF: ' + err.message);
      closeScanModal();
    }
  }

  function renderScanResults(res: any) {
    const modalScoreVal = document.getElementById('modalScoreVal');
    const modalScoreCategory = document.getElementById('modalScoreCategory');
    const modalScoreExp = document.getElementById('modalScoreExp');
    const modalBreakdownGrid = document.getElementById('modalBreakdownGrid');
    const modalRecsList = document.getElementById('modalRecsList');

    if (modalScoreVal) modalScoreVal.textContent = String(res.totalScore);
    if (modalScoreCategory) modalScoreCategory.textContent = res.scoreCategory;
    if (modalScoreExp) modalScoreExp.textContent = res.scoreExplanation;

    if (modalBreakdownGrid) {
      modalBreakdownGrid.innerHTML = res.breakdown.map((b: any) => `
        <div class="modal-breakdown-card">
          <div class="b-header">
            <span class="b-title">${b.category}</span>
            <span class="b-score">${b.score}/${b.maxScore}</span>
          </div>
          <p class="b-desc">${b.explanation}</p>
        </div>
      `).join('');
    }

    if (modalRecsList) {
      modalRecsList.innerHTML = res.recommendations.map((r: any) => `
        <div class="modal-rec-item priority-${r.priority}">
          <strong>${r.title}</strong>
          <p>${r.description}</p>
        </div>
      `).join('');
    }
  }

