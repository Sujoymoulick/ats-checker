    searchBar.classList.add('hidden');
  }

  function findNextText() {
    const query = searchInput.value;
    if (!query) return;
    const text = latexTextarea.value;
    const startPos = latexTextarea.selectionEnd || 0;
    const idx = text.toLowerCase().indexOf(query.toLowerCase(), startPos);

    if (idx !== -1) {
      latexTextarea.focus();
      latexTextarea.setSelectionRange(idx, idx + query.length);
    } else {
      // Loop to beginning
      const wrapIdx = text.toLowerCase().indexOf(query.toLowerCase(), 0);
      if (wrapIdx !== -1) {
        latexTextarea.focus();
        latexTextarea.setSelectionRange(wrapIdx, wrapIdx + query.length);
      }
    }
  }

  function replaceText() {
    const query = searchInput.value;
    const rep = replaceInput.value;
    if (!query) return;

    const start = latexTextarea.selectionStart;
    const end = latexTextarea.selectionEnd;
    const selected = latexTextarea.value.substring(start, end);

    if (selected.toLowerCase() === query.toLowerCase()) {
      latexTextarea.value = latexTextarea.value.substring(0, start) + rep + latexTextarea.value.substring(end);
      latexTextarea.selectionStart = start;
      latexTextarea.selectionEnd = start + rep.length;
      currentSource = latexTextarea.value;
      updateLineNumbers();
      findNextText();
    } else {
      findNextText();
    }
  }

  function replaceAllText() {
    const query = searchInput.value;
    const rep = replaceInput.value;
    if (!query) return;

    const regex = new RegExp(escapeRegExp(query), 'gi');
    latexTextarea.value = latexTextarea.value.replace(regex, rep);
    currentSource = latexTextarea.value;
    updateLineNumbers();
    saveToLocal(false);
  }

  function escapeRegExp(str: string) {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function setupDividerDrag() {
    let isDragging = false;

    workspaceDivider.addEventListener('mousedown', (e) => {
      isDragging = true;
      document.body.style.cursor = 'col-resize';
    });

    document.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      const bounds = builderWorkspace.getBoundingClientRect();
      const pct = ((e.clientX - bounds.left) / bounds.width) * 100;
      if (pct > 20 && pct < 80) {
        editorPanel.style.flex = `0 0 ${pct}%`;
        previewPanel.style.flex = `0 0 ${100 - pct}%`;
      }
    });

    document.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        document.body.style.cursor = 'default';
      }
    });
  }

  function setupMobileTabs() {
    tabCodeBtn.addEventListener('click', () => {
      tabCodeBtn.classList.add('active');
      tabPreviewBtn.classList.remove('active');
      editorPanel.style.display = 'flex';
      previewPanel.style.display = 'none';
    });

    tabPreviewBtn.addEventListener('click', () => {
      tabPreviewBtn.classList.add('active');
      tabCodeBtn.classList.remove('active');
      editorPanel.style.display = 'none';
      previewPanel.style.display = 'flex';
      if (currentCompiledPdfUrl) {
        loadAndRenderPdf(currentCompiledPdfUrl);
      }
    });

    window.addEventListener('beforeunload', () => {
      if (currentCompiledPdfUrl) {
        URL.revokeObjectURL(currentCompiledPdfUrl);
      }
      if (currentPdfDoc) {
        try { currentPdfDoc.destroy(); } catch (e) {}
      }
    });
  }
</script>

