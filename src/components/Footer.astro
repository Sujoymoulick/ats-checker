---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo">
          <img src="/logoblack.png" alt="GigpilotAIScore Logo" class="logo-img" width="28" height="28" />
          <span>GigpilotAIScore</span>
        </div>
        <p class="brand-desc">
          Check your resume for ATS compatibility, keywords, formatting issues, and job description alignment. 100% free, private, and client-side.
        </p>
        <div class="privacy-note" id="privacy">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
          <span>Private by design — your resume is analyzed in your browser and isn't uploaded to our servers.</span>
        </div>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">ATS Tools</h3>
        <ul>
          <li><a href="/ats-resume-checker">GigpilotAIScore Checker</a></li>
          <li><a href="/free-ats-checker">Free ATS Checker Tool</a></li>
          <li><a href="/ats-resume-score">ATS Resume Score Guide</a></li>
          <li><a href="/check-resume-for-ats">Check Resume For ATS</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">Features</h3>
        <ul>
          <li><a href="#uploader">Resume Parser</a></li>
          <li><a href="#job-description">Job Description Matching</a></li>
          <li><a href="#score">Deterministic ATS Score</a></li>
          <li><a href="#recommendations">Actionable Recommendations</a></li>
        </ul>
      </div>

      <div class="footer-links">
        <h3 class="footer-heading">Formats Supported</h3>
        <div class="format-tags">
          <span class="format-tag">.PDF</span>
          <span class="format-tag">.DOCX</span>
          <span class="format-tag">.TXT</span>
        </div>
        <p class="format-info">Client-side browser document text extraction.</p>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} GigpilotAIScore. All rights reserved.</p>
      <p class="disclaimer">
        Disclaimer: This checker provides heuristic compatibility analysis. ATS software implementations vary by vendor.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: #ffffff;
    padding: 4rem 1.5rem 2rem 1.5rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .logo-img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }

  .brand-desc {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .privacy-note {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: rgba(5, 150, 105, 0.08);
    border: 1px solid rgba(5, 150, 105, 0.2);
    border-radius: var(--radius-md);
    color: #047857;
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .footer-heading {
    color: var(--color-text);
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .format-tags {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .format-tag {
    padding: 0.25rem 0.625rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-primary);
  }

  .format-info {
    color: var(--color-text-dim);
    font-size: 0.8125rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    text-align: center;
    color: var(--color-text-dim);
    font-size: 0.8125rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
