---
---

<div class="ai-prompt-card" id="aiPromptSection">
  <div class="card-header">
    <div class="title-with-badge">
      <h3 class="card-title">Fix Your Resume with AI</h3>
      <span class="ai-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
        Auto-Generated AI Prompt
      </span>
    </div>
    <p class="card-subtitle">
      Use this custom prompt tailored to your ATS audit findings. Copy and paste it into ChatGPT, Claude, or Gemini to automatically fix identified problems and rewrite your resume.
    </p>
  </div>

  <!-- Prompt Mode Switcher Tabs -->
  <div class="prompt-mode-tabs" role="tablist">
    <button type="button" class="tab-btn active" data-mode="full" id="tabModeFull">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-3.05 11a22.35 22.35 0 0 1-3.95 2z"/></svg>
      Complete Resume Fix
    </button>
    <button type="button" class="tab-btn" data-mode="keywords" id="tabModeKeywords">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
      Add Missing Keywords
    </button>
    <button type="button" class="tab-btn" data-mode="bullets" id="tabModeBullets">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
      Boost Bullet Points & Metrics
    </button>
    <button type="button" class="tab-btn" data-mode="summary" id="tabModeSummary">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      Executive Summary
    </button>
  </div>

  <!-- Action Toolbar -->
  <div class="prompt-action-bar">
    <div class="quick-copy-group">
      <button type="button" class="btn-copy-prompt" id="copyPromptBtn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <span id="copyPromptBtnText">Copy AI Prompt</span>
      </button>
      <span class="copy-toast hidden" id="copyToast">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        Copied to Clipboard!
      </span>
    </div>

    <div class="ai-links-group">
      <span class="ai-links-label">Open in AI:</span>
      <a href="https://chatgpt.com" target="_blank" rel="noopener noreferrer" class="ai-link-btn btn-chatgpt">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.2819 9.8211a5.9847 5.9847 0 0 0-.5157-4.9108 6.0462 6.0462 0 0 0-6.5098-2.9A6.0651 6.0651 0 0 0 4.9807 4.1818a5.9847 5.9847 0 0 0-3.9977 2.9 6.0462 6.0462 0 0 0 .7427 7.0966 5.98 5.98 0 0 0 .511 4.9107 6.051 6.051 0 0 0 6.5146 2.9001A5.9847 5.9847 0 0 0 13.259 24a6.0557 6.0557 0 0 0 5.7718-4.2058 5.9894 5.9894 0 0 0 3.9977-2.9001 6.0557 6.0557 0 0 0-.7466-7.0729zm-9.022 12.6081a4.4755 4.4755 0 0 1-2.8764-1.0408l.1419-.0804 4.7783-2.7582a.7944.7944 0 0 0 .3927-.6813v-6.7369l2.02 1.1686a.071.071 0 0 1 .038.052v5.5826a4.504 4.504 0 0 1-4.4945 4.4944zm-9.6607-4.1254a4.4708 4.4708 0 0 1-.5346-3.0137l.142.0852 4.783 2.7582a.7707.7707 0 0 0 .7806 0l5.8428-3.3685v2.3324a.0804.0804 0 0 1-.0332.0615L9.74 19.9502a4.4992 4.4992 0 0 1-6.1408-1.6464zM2.3423 8.6056a4.466 4.466 0 0 1 2.3372-1.9733v5.6773a.7755.7755 0 0 0 .388.6766l5.838 3.3685-2.0152 1.1638a.0804.0804 0 0 1-.071 0l-4.8303-2.7914A4.4992 4.4992 0 0 1 2.3423 8.6056zm16.0997 3.8558l-5.838-3.3685 2.0152-1.1639a.0804.0804 0 0 1 .071 0l4.8303 2.7914a4.4944 4.4944 0 0 1-.6765 8.1042v-5.6773a.7755.7755 0 0 0-.402-.6859zm2.0058-2.6171l-.142-.0852-4.7735-2.7582a.7707.7707 0 0 0-.7854 0L8.899 10.364V8.0363a.0804.0804 0 0 1 .0332-.0615l4.8303-2.7961a4.4992 4.4992 0 0 1 6.6802 4.6657zm-8.9818-6.166a4.4755 4.4755 0 0 1 2.8764 1.0408l-.1419.0804-4.7783 2.7582a.7944.7944 0 0 0-.3927.6813v6.7369L6.969 13.7904a.071.071 0 0 1-.038-.052V8.1558a4.504 4.504 0 0 1 4.4945-4.4944z"/>
        </svg>
        ChatGPT
      </a>
      <a href="https://claude.ai" target="_blank" rel="noopener noreferrer" class="ai-link-btn btn-claude">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/>
        </svg>
        Claude
      </a>
      <a href="https://gemini.google.com" target="_blank" rel="noopener noreferrer" class="ai-link-btn btn-gemini">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/>
        </svg>
        Gemini
      </a>
    </div>
  </div>

  <!-- Prompt Box -->
  <div class="prompt-box-container">
    <div class="prompt-box-header">
      <span class="prompt-label">Prompt Content</span>
      <span class="prompt-stats" id="promptCharCount">0 characters</span>
    </div>
    <div class="prompt-content-wrapper">
      <pre class="prompt-code" id="aiPromptText">Upload a resume to generate your custom AI prompt...</pre>
    </div>
  </div>

  <!-- Instruction Tip -->
  <div class="ai-tip-box">
    <span class="tip-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
    </span>
    <p class="tip-text">
      <strong>Pro Tip:</strong> Click <strong>Copy AI Prompt</strong>, open ChatGPT, Claude, or Gemini in a new tab, paste the prompt into the chat, and press Send. The AI will output a fully rewritten, ATS-optimized version of your resume!
    </p>
  </div>
</div>

<style>
  .ai-prompt-card {
    background: var(--color-surface-card);
    border: 1px solid rgba(56, 189, 248, 0.3);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px -2px rgba(56, 189, 248, 0.08);
  }

  .card-header {
    margin-bottom: 1.25rem;
  }

  .title-with-badge {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.375rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .ai-badge {
    font-size: 0.75rem;
    font-weight: 700;
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.15) 0%, rgba(129, 140, 248, 0.15) 100%);
    color: var(--color-primary);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .card-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .prompt-mode-tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
  }

  .tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .tab-btn:hover {
    color: var(--color-text);
    border-color: var(--color-primary);
  }

  .tab-btn.active {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .prompt-action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .quick-copy-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .btn-copy-prompt {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 600;
    font-size: 0.875rem;
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(2, 132, 199, 0.25);
  }

  .btn-copy-prompt:hover {
    background: var(--color-primary-hover, #0284c7);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(2, 132, 199, 0.35);
  }

  .copy-toast {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #047857;
    background: rgba(5, 150, 105, 0.1);
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(5, 150, 105, 0.2);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    animation: fadeIn 0.2s ease-out;
  }

  .copy-toast.hidden {
    display: none;
  }

  .ai-links-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .ai-links-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .ai-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 0.2s ease;
    border: 1px solid var(--color-border);
  }

  .btn-chatgpt {
    background: #10a37f10;
    color: #10a37f;
    border-color: #10a37f40;
  }

  .btn-chatgpt:hover {
    background: #10a37f20;
    border-color: #10a37f;
  }

  .btn-claude {
    background: #d9770610;
    color: #d97706;
    border-color: #d9770640;
  }

  .btn-claude:hover {
    background: #d9770620;
    border-color: #d97706;
  }

  .btn-gemini {
    background: #2563eb10;
    color: #2563eb;
    border-color: #2563eb40;
  }

  .btn-gemini:hover {
    background: #2563eb20;
    border-color: #2563eb;
  }

  .prompt-box-container {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .prompt-box-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.625rem 1rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .prompt-label {
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .prompt-stats {
    color: var(--color-text-dim);
  }

  .prompt-content-wrapper {
    max-height: 300px;
    overflow-y: auto;
    padding: 1rem;
  }

  .prompt-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text);
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }

  .ai-tip-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: rgba(56, 189, 248, 0.06);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.875rem 1rem;
    border-radius: var(--radius-md);
  }

  .tip-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .tip-text {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-2px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .prompt-action-bar {
      flex-direction: column;
      align-items: stretch;
    }

    .quick-copy-group {
      justify-content: space-between;
    }

    .ai-links-group {
      justify-content: flex-start;
    }
  }
</style>
