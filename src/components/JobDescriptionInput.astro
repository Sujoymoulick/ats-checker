---
---

<div class="jd-container" id="jobDescriptionSection">
  <div class="jd-header">
    <div class="jd-title-wrap">
      <h3 class="jd-title">Want a more targeted analysis? <span class="badge-optional">(Optional)</span></h3>
      <p class="jd-subtitle">Paste the target job description to match skills, keywords, and job title alignment.</p>
    </div>
  </div>

  <div class="jd-body">
    <textarea 
      id="jdTextarea" 
      class="jd-textarea" 
      rows="5" 
      placeholder="Paste the job description here (responsibilities, required skills, tools, qualifications)..."
      aria-label="Target Job Description"
    ></textarea>
    
    <div class="jd-hint">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align: middle; margin-right: 4px; color: var(--color-warning);"><path d="M9 18h6"></path><path d="M10 22h4"></path><path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path></svg>
      <strong>Tip:</strong> Pasting a job description helps detect missing keywords and calculates exact role match percentage.
    </div>
  </div>

  <div class="jd-actions">
    <button type="button" id="analyzeBtn" class="btn-primary" disabled>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
        <polyline points="22 4 12 14.01 9 11.01"></polyline>
      </svg>
      <span>Analyze My Resume</span>
    </button>

    <button type="button" id="skipJdBtn" class="btn-secondary" disabled>
      <span>Skip Job Description & Analyze</span>
    </button>
  </div>
</div>

<style>
  .jd-container {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    margin-bottom: 2rem;
  }

  .jd-header {
    margin-bottom: 1rem;
  }

  .jd-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-optional {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background: #f1f5f9;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
  }

  .jd-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.25rem;
  }

  .jd-textarea {
    width: 100%;
    background: #ffffff;
    border: 1px solid var(--color-border-light);
    border-radius: var(--radius-lg);
    padding: 1rem;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.5;
    resize: vertical;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .jd-textarea:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-glow);
  }

  .jd-hint {
    font-size: 0.8125rem;
    color: var(--color-text-dim);
    margin-top: 0.5rem;
  }

  .jd-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
    color: #ffffff;
    font-weight: 600;
    font-size: 1rem;
    padding: 0.875rem 1.75rem;
    border-radius: var(--radius-lg);
    border: none;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);
    transition: all 0.2s ease;
  }

  .btn-primary:hover:not(:disabled) {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(56, 189, 248, 0.4);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    box-shadow: none;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--color-border-light);
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.9375rem;
    padding: 0.875rem 1.25rem;
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover:not(:disabled) {
    border-color: var(--color-primary);
    color: var(--color-text);
  }

  .btn-secondary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>
