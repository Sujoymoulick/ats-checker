---
import Layout from '../layouts/Layout.astro';
import ATSCheckerApp from '../components/ATSCheckerApp.astro';
import FAQ from '../components/FAQ.astro';
---

<Layout 
  title="GigpilotAIScore – Free ATS Resume & AI Score Checker"
  description="Check your resume for ATS compatibility, keywords, formatting issues, and job-description matching directly in your browser. 100% Free, Private, and No Signup Required."
  activePath="/"
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-container">
      <div class="hero-badge" data-reveal="scale">
        <span class="pulse-dot"></span>
        <span>100% Browser-Based & Private</span>
      </div>

      <h1 class="hero-title" data-reveal="fade-up">
        GigpilotAIScore
      </h1>

      <p class="hero-subtitle" data-reveal="fade-up" style="--reveal-delay: 80ms;">
        Check your resume for ATS compatibility, keywords, formatting issues, and job-description matching — directly in your browser.
      </p>

      <div class="hero-trust-list" data-reveal-group data-reveal-type="scale" data-reveal-stagger="60">
        <span class="trust-item" data-reveal-item>✓ Free forever</span>
        <span class="trust-item" data-reveal-item>✓ No signup</span>
        <span class="trust-item" data-reveal-item>✓ No backend</span>
        <span class="trust-item" data-reveal-item>✓ 100% Private</span>
        <span class="trust-item" data-reveal-item>✓ Resume stays on your device</span>
      </div>

      <!-- App Interface -->
      <div class="hero-app-wrap" data-reveal="scale" style="--reveal-delay: 150ms;">
        <ATSCheckerApp />
      </div>
    </div>
  </section>

  <!-- Feature Highlights -->
  <section class="features-section">
    <div class="section-container">
      <div class="section-header" data-reveal="fade-up">
        <h2 class="section-title">What Our ATS Resume Checker Scans</h2>
        <p class="section-subtitle">Comprehensive client-side evaluation matching real applicant tracking system standards</p>
      </div>

      <div class="features-grid" data-reveal-group data-reveal-type="scale" data-reveal-stagger="90">
        <div class="feature-card highlight-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="6"></circle><circle cx="12" cy="12" r="2"></circle></svg>
          </div>
          <h3>Job Description Keyword Match</h3>
          <p>Extracts technical skills, certifications, and qualifications from the target job posting and measures your exact keyword coverage.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          </div>
          <h3>Transparent ATS Score out of 100</h3>
          <p>Evaluates your resume using a deterministic scoring engine covering contact details, structure, keywords, formatting, and impact metrics.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <h3>Formatting Risk Detection</h3>
          <p>Flags multi-column tables, long symbol dividers, image-only scanned PDFs, and unusual bullet symbols that confuse parsers.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          </div>
          <h3>Section & Contact Detection</h3>
          <p>Identifies standard section headers (Experience, Education, Skills) and verifies essential contact information like email and phone.</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
          </div>
          <h3>Measurable Impact & Verbs</h3>
          <p>Scans bullet points for strong action verbs and quantifiable results (percentages, revenue, time saved, growth metrics).</p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          </div>
          <h3>100% Private & Local</h3>
          <p>Your resume file is parsed locally inside your web browser. Zero server uploads, zero accounts, and zero cloud storage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works-section">
    <div class="section-container">
      <div class="section-header" data-reveal="fade-up">
        <h2 class="section-title">How Our Client-Side ATS Checker Works</h2>
        <p class="section-subtitle">Get instant resume feedback in 4 simple steps without creating an account</p>
      </div>

      <div class="steps-grid" data-reveal-group data-reveal-type="fade-up" data-reveal-stagger="100">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Upload Your Resume</h3>
          <p>Drop your PDF, DOCX, or TXT resume file into the browser checker.</p>
        </div>

        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Paste Job Description (Optional)</h3>
          <p>Add the job description text to analyze specific skill and role alignment.</p>
        </div>

        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Browser Text Extraction</h3>
          <p>Our client-side parser reads your resume text locally using JavaScript.</p>
        </div>

        <div class="step-card">
          <div class="step-num">4</div>
          <h3>Review Your ATS Report</h3>
          <p>Inspect your score out of 100, keyword matches, formatting risks, and fix list.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO Content Guide Section -->
  <section class="seo-guide-section">
    <div class="section-container">
      <article class="seo-article">
        <header class="seo-header" data-reveal="fade-up">
          <span class="seo-badge">Comprehensive Resume Optimization Guide</span>
          <h2 class="seo-main-title">Master the Job Application Process with Our Free ATS Checker Online</h2>
          <p class="seo-lead">
            Landing your dream job across the United States—whether you are a Gen Z candidate entering the competitive workforce, a seasoned adult career switcher, or a remote gig professional—starts with beating automated applicant screening algorithms. Learn how using a high-accuracy <strong>free ats checker online</strong> and <strong>free resume checker online</strong> ensures your application bypasses automated software filters and lands directly on recruiter desks.
          </p>
        </header>

        <div class="seo-body">
          <section class="seo-block" data-reveal="fade-up">
            <h3>Why 75% of Job Applications Fail the Initial ATS Filter</h3>
            <p>
              Modern hiring across US companies relies heavily on corporate Applicant Tracking Systems (ATS) such as Workday, Greenhouse, Lever, iCIMS, and Taleo. Before a human recruiter or hiring manager ever views your document, automated text extraction software evaluates your submission for targeted job keywords, structured work history, and standard formatting. Studies show that up to 75% of submitted applications are auto-rejected due to unreadable multi-column layouts, hidden text boxes, missing hard skills, or unsupported file formats.
            </p>
            <p>
              By leveraging a reliable <strong>free ats resume checker</strong> and <strong>free online ats checker</strong> before submitting your application, you gain complete visibility into how robots read your file. Instead of sending out dozens of resumes blindly and waiting for callbacks that never arrive, running a pre-application audit allows you to correct formatting red flags, align your qualifications with job requirements, and boost your response rate.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>Understanding Your Resume Metrics: The Power of a Free ATS Score Checker</h3>
            <p>
              When employers post competitive openings, ATS software automatically scores and ranks incoming applicants based on contextual keyword overlap. Our <strong>free ats score checker</strong> gives you instant, transparent feedback across the core criteria used by top corporate ATS engines:
            </p>
            <ul class="seo-list">
              <li><strong>Keyword Matching:</strong> Scans target job descriptions to extract required hard skills, software tools, industry certifications, and key responsibilities, comparing them against your text.</li>
              <li><strong>Formatting & Structural Risk:</strong> Identifies complex table borders, graphics, sidebars, headers/footers, and non-standard bullet symbols that cause parsing errors.</li>
              <li><strong>Impact & Metric Density:</strong> Analyzes experience bullet points for action-oriented verbs and quantifiable achievements (percentages, revenue growth, cost savings, project scope).</li>
              <li><strong>Section & Contact Detection:</strong> Verifies standard heading conventions (Work Experience, Education, Skills, Summary) and confirms essential contact information (Email, Phone, Location, LinkedIn) is properly extracted.</li>
            </ul>
            <p>
              Our automated <strong>free resume scoring</strong> engine generates a clear, actionable score out of 100. Understanding your calculated <strong>free ats score</strong> and overall <strong>free resume score</strong> enables you to pinpoint exact missing terms, optimize line spacing, and maximize your match percentage.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>How to Run a Deep Free Resume Scan & Free ATS Scan</h3>
            <p>
              Conducting a rigorous resume evaluation shouldn't require credit card entries, trial subscriptions, or uploading your confidential personal data to foreign cloud servers. At GigPilotAIScore, you can perform a thorough <strong>free ats scan</strong> and <strong>free resume scan</strong> directly inside your web browser.
            </p>
            <p>
              Powered by client-side text parsing, our <strong>free resume scanner</strong> and <strong>free ats resume scanner</strong> read your PDF, DOCX, or TXT file locally on your device. The scanner cross-references your content against industry-standard ATS parsing rules, delivering real-time keyword reports, visual risk warnings, and targeted recommendations in seconds.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>Avoid Common Formatting Traps with a Free ATS Compatibility Test</h3>
            <p>
              Even candidates with impressive experience can get eliminated if their file formatting breaks automated parsers. Top formatting mistakes include using double-column templates, placing contact details in header text zones, using custom icon bullets, or exporting documents as unsearchable image-based PDF scans.
            </p>
            <p>
              Executing a <strong>free ats compatibility test</strong> with our <strong>free ats compatibility checker</strong> ensures your document remains 100% parser-friendly and recruiter-readable. Whether you submit standard Word documents or compiled PDFs, our test confirms that section headers, job titles, and employment dates map correctly into database fields.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>Test Your Job Readiness with a Free ATS Test and Resume Checker</h3>
            <p>
              Before applying to top US opportunities on platforms like LinkedIn, Indeed, ZipRecruiter, or company career portals, spend two minutes conducting a <strong>free ats test</strong> and <strong>free resume ats test</strong>.
            </p>
            <p>
              Utilizing a dedicated <strong>free resume checker</strong> and <strong>free resume ats checker</strong> gives you a decisive advantage in today's job market. Customizing your resume to align with specific role requirements can triple your interview callback frequency. Our diagnostic report reveals exact missing keywords, allowing you to tailor your resume for every application seamlessly.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>CV vs. Resume: Utilizing a Free CV Checker & Free ATS CV Checker</h3>
            <p>
              Depending on your industry, career stage, or geographic target, application standards vary. Whether you need a short single-page US resume or an extensive multi-page Curriculum Vitae for academic, medical, or international roles, our platform functions as a full-featured <strong>free cv checker</strong> and <strong>free cv ats checker</strong>.
            </p>
            <p>
              Our integrated <strong>free cv scanner</strong> and <strong>free ats cv checker</strong> handle extended publication lists, research grants, and comprehensive employment histories with ease. You receive the exact same high-level keyword coverage, formatting diagnostics, and privacy protection regardless of document length or format.
            </p>
          </section>

          <section class="seo-block" data-reveal="fade-up">
            <h3>100% Free, Private, and Browser-Based Resume Optimization</h3>
            <p>
              Unlike legacy online platforms that lock detailed reports behind paywalls or sell user data to recruitment networks, GigPilotAIScore is built with a zero-storage, privacy-first commitment. When you use our <strong>free online resume checker</strong> and <strong>free ats checker</strong>, your file remains entirely on your machine.
            </p>
            <p>
              Start using our <strong>free ats checker</strong> today on <strong>gigpilotaiscore.gigpilotai.com</strong>. Eliminate ATS red flags, elevate your score, and secure more job interviews faster.
            </p>
          </section>
        </div>
      </article>
    </div>
  </section>

  <!-- FAQ Section -->
  <FAQ />
</Layout>

<style>
  .hero-section {
    padding: 4rem 1.5rem 2rem 1.5rem;
  }

  .hero-container {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.2);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-primary);
    box-shadow: 0 0 8px rgba(2, 132, 199, 0.4);
  }

  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto 1.75rem auto;
    line-height: 1.6;
  }

  .hero-trust-list {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .trust-item {
    font-size: 0.875rem;
    font-weight: 600;
    color: #047857;
    background: rgba(5, 150, 105, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(5, 150, 105, 0.2);
  }

  .hero-app-wrap {
    text-align: left;
  }

  /* Features Grid */
  .features-section {
    padding: 5rem 1.5rem;
    background: #f1f5f9;
    border-top: 1px solid var(--color-border);
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  .feature-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .feature-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-light);
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* How It Works */
  .how-it-works-section {
    padding: 5rem 1.5rem;
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .step-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 1.75rem;
    position: relative;
  }

  .step-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--color-primary-glow);
    color: var(--color-primary);
    font-weight: 800;
    font-size: 1.125rem;
    border: 1px solid rgba(56, 189, 248, 0.3);
    margin-bottom: 1.25rem;
  }

  .step-card h3 {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .step-card p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* SEO Guide Section */
  .seo-guide-section {
    padding: 5rem 1.5rem;
    background: #ffffff;
    border-top: 1px solid var(--color-border);
  }

  .seo-article {
    max-width: 900px;
    margin: 0 auto;
  }

  .seo-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .seo-badge {
    display: inline-block;
    padding: 0.35rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgba(2, 132, 199, 0.08);
    border: 1px solid rgba(2, 132, 199, 0.2);
    color: var(--color-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }

  .seo-main-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text);
    line-height: 1.25;
    margin-bottom: 1.25rem;
    letter-spacing: -0.015em;
  }

  .seo-lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
  }

  .seo-body {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .seo-block {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2rem 2.25rem;
  }

  .seo-block h3 {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
    line-height: 1.3;
  }

  .seo-block p {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .seo-block p:last-child {
    margin-bottom: 0;
  }

  .seo-list {
    color: var(--color-text-muted);
    font-size: 0.96875rem;
    line-height: 1.75;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .seo-list li {
    margin-bottom: 0.5rem;
  }

  .seo-list li strong {
    color: var(--color-text);
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.25rem; }
    .hero-subtitle { font-size: 1.0625rem; }
    .seo-main-title { font-size: 1.75rem; }
    .seo-block { padding: 1.5rem 1.25rem; }
  }
</style>
