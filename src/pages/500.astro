---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="System Error (500) – GigpilotAIScore"
  description="An unexpected system error occurred. GigpilotAIScore runs 100% locally inside your browser."
  activePath="/500"
>
  <section class="error-hero">
    <div class="error-container">
      <div class="error-badge" data-reveal="scale">
        <span class="badge-dot"></span>
        System Error 500
      </div>

      <div class="error-code-display" data-reveal="fade-up">500</div>

      <h1 class="error-title" data-reveal="fade-up" style="--reveal-delay: 60ms;">
        Something Went Wrong
      </h1>

      <p class="error-description" data-reveal="fade-up" style="--reveal-delay: 120ms;">
        An unexpected error occurred while processing your request. Because GigpilotAIScore processes your resume 100% locally inside your web browser, this issue is typically resolved by refreshing the page or checking your file format.
      </p>

      <div class="error-actions" data-reveal="fade-up" style="--reveal-delay: 180ms;">
        <button onclick="window.location.reload()" class="btn-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path></svg>
          Reload Page
        </button>
        <a href="/" class="btn-secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          Back to Home
        </a>
      </div>

      <div class="troubleshoot-card" data-reveal="scale" style="--reveal-delay: 240ms;">
        <h2 class="box-heading">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          Troubleshooting Tips
        </h2>
        <ul class="tips-list">
          <li><strong>Supported File Types:</strong> Ensure your file is a valid PDF (.pdf), Microsoft Word (.docx), or Plain Text (.txt) document under 10MB.</li>
          <li><strong>Text-Based PDF:</strong> If uploading a PDF, ensure it contains selectable text rather than a scanned image.</li>
          <li><strong>Browser Memory:</strong> Large files with heavy graphics might exceed browser tab memory. Try closing unused tabs or testing in an Incognito / Private window.</li>
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-hero {
    padding: 5rem 1.5rem;
    text-align: center;
  }

  .error-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: var(--radius-full);
    background: rgba(217, 119, 6, 0.08);
    border: 1px solid rgba(217, 119, 6, 0.2);
    color: var(--color-warning);
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-warning);
  }

  .error-code-display {
    font-size: 6.5rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-warning);
    background: linear-gradient(135deg, var(--color-warning) 0%, var(--color-error) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.75rem;
  }

  .error-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--color-text);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .error-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 620px;
    margin: 0 auto 2.5rem;
  }

  .error-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background-color: var(--color-primary);
    color: #ffffff;
    border: none;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-hover);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background-color: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn-secondary:hover {
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-light);
    color: var(--color-text);
  }

  .troubleshoot-card {
    background: var(--color-surface-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: 2.5rem 2rem;
    text-align: left;
    box-shadow: var(--shadow-sm);
  }

  .box-heading {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1.25rem;
  }

  .box-heading svg {
    color: var(--color-warning);
  }

  .tips-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-left: 0;
  }

  .tips-list li {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .tips-list li::before {
    content: "•";
    position: absolute;
    left: 0.5rem;
    color: var(--color-primary);
    font-weight: bold;
  }

  @media (max-width: 640px) {
    .error-code-display {
      font-size: 5rem;
    }
    .error-title {
      font-size: 1.75rem;
    }
    .error-hero {
      padding: 3rem 1rem;
    }
  }
</style>
