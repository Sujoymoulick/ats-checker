---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  activePath?: string;
  noindex?: boolean;
  ogImage?: string;
  type?: string;
}

const {
  title = 'Free ATS Checker & AI Resume Score | GigPilotAIScore',
  description = 'Free ATS checker to scan your resume for keywords, formatting risks, and job description fit directly in your browser. 100% private with instant AI scoring.',
  activePath = '/',
  noindex = false,
  ogImage = 'https://gigpilotaiscore.gigpilotai.com/og-image.png',
  type = 'website'
} = Astro.props;

const siteDomain = 'https://gigpilotaiscore.gigpilotai.com';
const canonicalUrl = `${siteDomain}${activePath === '/' ? '' : activePath}`;

// Breadcrumb Schema construction
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": siteDomain
  }
];

if (activePath !== '/') {
  const pageNameMap: Record<string, string> = {
    '/ats-resume-checker': 'Free ATS Resume Checker',
    '/free-ats-checker': 'Free ATS Checker & Scanner',
    '/ats-resume-score': 'ATS Resume Score Guide',
    '/check-resume-for-ats': 'Check Resume for ATS Guide',
    '/about': 'About Us',
    '/privacy': 'Privacy Policy',
    '/terms': 'Terms and Conditions',
    '/ats-benchmark': 'ATS Calibration Benchmark'
  };

  breadcrumbItems.push({
    "@type": "ListItem",
    "position": 2,
    "name": pageNameMap[activePath] || 'Guide',
    "item": canonicalUrl
  });
}

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "GigPilotAIScore",
  "url": siteDomain,
  "description": "100% Free, Private & Client-Side ATS Resume Checker & AI Score Scanner"
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "GigPilotAIScore",
  "url": siteDomain,
  "logo": `${siteDomain}/favicon.svg`
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "GigPilotAIScore Free ATS Resume Checker",
  "url": siteDomain,
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "100% Client-side browser text extraction",
    "Deterministic ATS Score out of 100",
    "Job description keyword matching",
    "Formatting risk & table detection",
    "No signups or credit card required"
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is an ATS resume checker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "An Applicant Tracking System (ATS) resume checker scans your resume file using parsing algorithms similar to those used by employers. It checks whether your text, sections, formatting, and keywords are easily readable by automated recruitment software."
      }
    },
    {
      "@type": "Question",
      "name": "Is this ATS resume checker 100% free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Our ATS resume checker is completely free with no hidden fees, premium paywalls, or limits on how many times you can test your resume."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need to create an account or sign up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No signup or account creation is required. You can immediately upload your resume and receive a comprehensive score report."
      }
    },
    {
      "@type": "Question",
      "name": "Is my resume uploaded to an external server?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Your privacy is guaranteed. All text extraction and ATS analysis happen 100% client-side directly inside your browser window. No resume data ever leaves your device."
      }
    },
    {
      "@type": "Question",
      "name": "Can I check my resume against a specific job description?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! You can paste any job description into the checker. The tool extracts key technical skills, tools, and qualifications required by the employer and measures your exact keyword match percentage."
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-H988QNSY9M"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-H988QNSY9M');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Favicons & Web App Manifest -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="GigPilotAIScore" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#020101" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="GigPilotAIScore" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:domain" content="gigpilotaiscore.gigpilotai.com" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Robots Directives -->
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400..800;1,400..800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <Header activePath={activePath} />
    <main>
      <slot />
    </main>
    <Footer />
    
    <script>
      // Scroll-Reveal System driven by design-taste-frontend skill directives
      function initScrollReveal() {
        const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        
        // 1. Process group containers for staggered animations
        const groups = document.querySelectorAll('[data-reveal-group]');
        groups.forEach((group) => {
          const staggerStep = parseInt(group.getAttribute('data-reveal-stagger') || '80', 10);
          const items = group.querySelectorAll('[data-reveal-item], .feature-card, .step-card, .eval-card, .tier-card, .faq-item, .breakdown-item, .rec-item');
          
          items.forEach((item, index) => {
            if (!item.hasAttribute('data-reveal')) {
              item.setAttribute('data-reveal', group.getAttribute('data-reveal-type') || 'scale');
            }
            (item as HTMLElement).style.setProperty('--reveal-delay', `${index * staggerStep}ms`);
          });
        });

        const revealElements = document.querySelectorAll('[data-reveal]');
        if (revealElements.length === 0) return;

        if (isReducedMotion) {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const observerOptions: IntersectionObserverInit = {
          root: null,
          rootMargin: '0px 0px -40px 0px',
          threshold: 0.08,
        };

        const observer = new IntersectionObserver((entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const target = entry.target as HTMLElement;
              target.classList.add('is-revealed');
              obs.unobserve(target); // Only trigger once for clean entry
            }
          });
        }, observerOptions);

        revealElements.forEach((el) => {
          // If element is already high in the viewport on page load, reveal immediately
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.88) {
            el.classList.add('is-revealed');
          } else {
            observer.observe(el);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }

      // Re-run on Astro page transitions or dynamic DOM updates
      document.addEventListener('astro:page-load', initScrollReveal);

      // Observe dynamic changes (e.g., when ATS analysis results load)
      const mutationObserver = new MutationObserver(() => {
        initScrollReveal();
      });
      mutationObserver.observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
