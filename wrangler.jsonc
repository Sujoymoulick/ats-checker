{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gigpilot-ai-score",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT_KV",
      "id": "rate_limit_kv_id"
    }
  ]
}
